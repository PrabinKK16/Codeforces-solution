#include<bits/stdc++.h>
using namespace std;
 
void solve() {
    int n;
    cin >> n;
 
    int x;
    cin >> x;
 
    vector<int> v;
    v.resize(n);
    unordered_set<int> st;
 
    for (int i = 0; i < n; i++) {
        cin >> v[i];
        st.insert(v[i]);
    }
 
    if (st.find(x) != st.end()) {
        cout << "Yes" << endl;
        return;
    }
 
    cout << "No" << endl;
}
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
 
    int t = 1;
    cin >> t;
 
    while (t--) {
        solve();
    }
 
    return 0;
}