#include <bits/stdc++.h>
using namespace std;
 
void solve() {
    int n, k;
    cin >> n >> k;
 
    string s;
    cin >> s;
 
    if (2 * k > n) {
        cout << -1 << endl;
        return;
    }
 
    int result   = 0;
 
    for (int i = 0; i < k; i++) {
        if (s[i] == 'L') result++;
    }
 
    for (int i = n - k; i < n; i++) {
        if (s[i] == 'R') result++;
    }
 
    cout << result << endl;
}
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
 
    int t = 1;
    cin >> t;
    
    while (t--) {
        solve();
    }
 
    return 0;
}